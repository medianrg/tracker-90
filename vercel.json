{
  "crons": [
    { "path": "/api/remind?slot=morning", "schedule": "0 5 * * *" },
    { "path": "/api/remind?slot=lunch", "schedule": "0 10 * * *" },
    { "path": "/api/remind?slot=evening", "schedule": "0 19 * * *" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ]
}
